<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:Prophet.Client.Controls"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="Prophet.Client.Views.Pages.MarketView">
    
    <UserControl.Styles>
        <!-- 时间框架按钮样式 -->
        <!-- 默认状态：深灰背景 -->
        <Style Selector="ToggleButton.timeframe-btn /template/ ContentPresenter">
            <Setter Property="Background" Value="#4B4F54"/>
        </Style>
        <!-- 悬停状态（未选中）：浅灰背景 -->
        <Style Selector="ToggleButton.timeframe-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#848E9C"/>
        </Style>
        <!-- 选中状态：金黄色背景 + 白色文字 -->
        <Style Selector="ToggleButton.timeframe-btn:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="#F0B90B"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <!-- 选中+悬停状态：浅黄色背景 + 白色文字 -->
        <Style Selector="ToggleButton.timeframe-btn:checked:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#FCD535"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        
        <!-- K线样式按钮样式 -->
        <!-- 默认状态：深灰背景 -->
        <Style Selector="ToggleButton.style-btn /template/ ContentPresenter">
            <Setter Property="Background" Value="#4B4F54"/>
        </Style>
        <!-- 悬停状态（未选中）：浅灰背景 -->
        <Style Selector="ToggleButton.style-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#848E9C"/>
        </Style>
        <!-- 选中状态：金黄色背景 + 白色文字 -->
        <Style Selector="ToggleButton.style-btn:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="#F0B90B"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <!-- 选中+悬停状态：浅黄色背景 + 白色文字 -->
        <Style Selector="ToggleButton.style-btn:checked:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#FCD535"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
    </UserControl.Styles>
    
    <Grid RowDefinitions="Auto,Auto,*" Background="{DynamicResource Background1Brush}">
        
        <!-- 数据加载提示层（覆盖整个内容区域） -->
        <Border x:Name="LoadingOverlay"
                Grid.Row="0" Grid.RowSpan="3"
                Background="#80000000"
                IsVisible="False"
                ZIndex="999">
            <StackPanel VerticalAlignment="Center" 
                        HorizontalAlignment="Center"
                        Spacing="16">
                <!-- 加载动画 -->
                <Border Width="80" Height="80"
                        Background="{DynamicResource Background2Brush}"
                        CornerRadius="12"
                        BoxShadow="0 4 20 #40000000">
                    <Grid Width="48" Height="48"
                          x:Name="LoadingIcon">
                        <Grid.RenderTransform>
                            <RotateTransform/>
                        </Grid.RenderTransform>
                        <Viewbox>
                            <Path Data="{StaticResource IconLoading}"
                                  Fill="#F0B90B"
                                  Stretch="Uniform"/>
                        </Viewbox>
                    </Grid>
                </Border>
                <!-- 加载文字 -->
                <TextBlock x:Name="LoadingText"
                           Text="正在加载市场数据..."
                           FontSize="14"
                           Foreground="{DynamicResource Text1Brush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
        
        <!-- 标题栏 -->
        <Border Grid.Row="0" 
                Padding="16,10"
                Background="{DynamicResource Background1Brush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <TextBlock Text="行情中心" 
                       Classes="Title2"
                       Foreground="{DynamicResource Text1Brush}"/>
        </Border>
        
        <!-- K线控制工具栏（采用底部信息栏的圆角样式） -->
        <Border Grid.Row="1"
                Margin="10,10,10,0"
                Background="{DynamicResource Background2Brush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0"
                CornerRadius="8"
                Padding="10">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                
                <!-- 第1列：Symbol选择下拉框 -->
                <Border Grid.Column="0"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0"
                        CornerRadius="0"
                        Padding="0"
                        Margin="0,0,10,0">
                    <ComboBox x:Name="SymbolComboBox"
                              Width="120"
                              Height="32"
                              FontSize="12"
                              Padding="12,6"
                              CornerRadius="8"
                              Background="{DynamicResource Background3Brush}"
                              Foreground="{DynamicResource Text1Brush}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              BorderThickness="1"
                              HorizontalContentAlignment="Left"
                              VerticalContentAlignment="Center"
                              SelectionChanged="OnSymbolChanged">
                        <!-- 动态绑定到AppConfig.Symbols -->
                        <ComboBoxItem Content="XRPUSDT"/>
                        <ComboBoxItem Content="DOGEUSDT"/>
                        <ComboBoxItem Content="SUIUSDT"/>
                    </ComboBox>
                </Border>
                
                <!-- 第2列：时间框架 -->
                <Border Grid.Column="1"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0"
                        CornerRadius="0"
                        Padding="0">
                    <StackPanel Orientation="Horizontal" Spacing="0">
                        <ToggleButton x:Name="Btn1m" 
                                      Classes="timeframe-btn"
                                      Content="1m" 
                                      Width="48"
                                      Height="32" 
                                      FontSize="11" 
                                      Padding="8,0"
                                      CornerRadius="8,0,0,8"
                                      BorderBrush="#1E2329"
                                      BorderThickness="0"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      Cursor="Hand"
                                      Click="OnTimeFrameChanged"/>
                        <ToggleButton x:Name="Btn3m" 
                                      Classes="timeframe-btn"
                                      Content="3m" 
                                      Width="48"
                                      Height="32" 
                                      FontSize="11" 
                                      Padding="8,0"
                                      CornerRadius="0"
                                      BorderBrush="#1E2329"
                                      BorderThickness="0"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      Cursor="Hand"
                                      Click="OnTimeFrameChanged"/>
                        <ToggleButton x:Name="Btn5m" 
                                      Classes="timeframe-btn"
                                      Content="5m" 
                                      Width="48"
                                      Height="32" 
                                      FontSize="11" 
                                      Padding="8,0"
                                      CornerRadius="0"
                                      BorderBrush="#1E2329"
                                      BorderThickness="0"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      Cursor="Hand"
                                      Click="OnTimeFrameChanged"/>
                        <ToggleButton x:Name="Btn15m" 
                                      Classes="timeframe-btn"
                                      Content="15m" 
                                      Width="48"
                                      Height="32" 
                                      FontSize="11" 
                                      Padding="8,0"
                                      CornerRadius="0"
                                      BorderBrush="#1E2329"
                                      BorderThickness="0"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      Cursor="Hand"
                                      Click="OnTimeFrameChanged"
                                      IsChecked="True"/>
                        <ToggleButton x:Name="Btn30m" 
                                      Classes="timeframe-btn"
                                      Content="30m" 
                                      Width="48"
                                      Height="32" 
                                      FontSize="11" 
                                      Padding="8,0"
                                      CornerRadius="0"
                                      BorderBrush="#1E2329"
                                      BorderThickness="0"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      Cursor="Hand"
                                      Click="OnTimeFrameChanged"/>
                        <ToggleButton x:Name="Btn1h" 
                                      Classes="timeframe-btn"
                                      Content="1h" 
                                      Width="48"
                                      Height="32" 
                                      FontSize="11" 
                                      Padding="8,0"
                                      CornerRadius="0"
                                      BorderBrush="#1E2329"
                                      BorderThickness="0"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      Cursor="Hand"
                                      Click="OnTimeFrameChanged"/>
                        <ToggleButton x:Name="Btn2h" 
                                      Classes="timeframe-btn"
                                      Content="2h" 
                                      Width="48"
                                      Height="32" 
                                      FontSize="11" 
                                      Padding="8,0"
                                      CornerRadius="0"
                                      BorderBrush="#1E2329"
                                      BorderThickness="0"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      Cursor="Hand"
                                      Click="OnTimeFrameChanged"/>
                        <ToggleButton x:Name="Btn4h" 
                                      Classes="timeframe-btn"
                                      Content="4h" 
                                      Width="48"
                                      Height="32" 
                                      FontSize="11" 
                                      Padding="8,0"
                                      CornerRadius="0"
                                      BorderBrush="#1E2329"
                                      BorderThickness="0"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      Cursor="Hand"
                                      Click="OnTimeFrameChanged"/>
                        <ToggleButton x:Name="Btn6h" 
                                      Classes="timeframe-btn"
                                      Content="6h" 
                                      Width="48"
                                      Height="32" 
                                      FontSize="11" 
                                      Padding="8,0"
                                      CornerRadius="0"
                                      BorderBrush="#1E2329"
                                      BorderThickness="0"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      Cursor="Hand"
                                      Click="OnTimeFrameChanged"/>
                        <ToggleButton x:Name="Btn8h" 
                                      Classes="timeframe-btn"
                                      Content="8h" 
                                      Width="48"
                                      Height="32" 
                                      FontSize="11" 
                                      Padding="8,0"
                                      CornerRadius="0"
                                      BorderBrush="#1E2329"
                                      BorderThickness="0"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      Cursor="Hand"
                                      Click="OnTimeFrameChanged"/>
                        <ToggleButton x:Name="Btn12h" 
                                      Classes="timeframe-btn"
                                      Content="12h" 
                                      Width="48"
                                      Height="32" 
                                      FontSize="11" 
                                      Padding="8,0"
                                      CornerRadius="0"
                                      BorderBrush="#1E2329"
                                      BorderThickness="0"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      Cursor="Hand"
                                      Click="OnTimeFrameChanged"/>
                        <ToggleButton x:Name="Btn1d" 
                                      Classes="timeframe-btn"
                                      Content="1d" 
                                      Width="48"
                                      Height="32" 
                                      FontSize="11" 
                                      Padding="8,0"
                                      CornerRadius="0,8,8,0"
                                      BorderBrush="#1E2329"
                                      BorderThickness="0"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      Cursor="Hand"
                                      Click="OnTimeFrameChanged"/>
                    </StackPanel>
                </Border>
                
                <!-- 第3列：K线样式（中间） -->
                <Border Grid.Column="2"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0"
                        CornerRadius="0"
                        Padding="0"
                        Margin="10,0,0,0"
                        HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="0">
                        <ToggleButton x:Name="BtnCandleStyle" 
                                      Classes="style-btn"
                                      Content="蜡烛图" 
                                      Width="60"
                                      Height="32" 
                                      FontSize="11" 
                                      Padding="8,0"
                                      CornerRadius="8,0,0,8"
                                      BorderBrush="#1E2329"
                                      BorderThickness="0"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      Cursor="Hand"
                                      Click="OnCandleStyleChanged"
                                      IsChecked="True"/>
                        <ToggleButton x:Name="BtnLineStyle" 
                                      Classes="style-btn"
                                      Content="美国线" 
                                      Width="60"
                                      Height="32" 
                                      FontSize="11" 
                                      Padding="8,0"
                                      CornerRadius="0"
                                      BorderBrush="#1E2329"
                                      BorderThickness="0"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      Cursor="Hand"
                                      Click="OnCandleStyleChanged"/>
                        <ToggleButton x:Name="BtnLineChartStyle" 
                                      Classes="style-btn"
                                      Content="折线图" 
                                      Width="60"
                                      Height="32" 
                                      FontSize="11" 
                                      Padding="8,0"
                                      CornerRadius="0"
                                      BorderBrush="#1E2329"
                                      BorderThickness="0"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      Cursor="Hand"
                                      Click="OnCandleStyleChanged"/>
                        <ToggleButton x:Name="BtnAreaStyle" 
                                      Classes="style-btn"
                                      Content="面积图" 
                                      Width="60"
                                      Height="32" 
                                      FontSize="11" 
                                      Padding="8,0"
                                      CornerRadius="0,8,8,0"
                                      BorderBrush="#1E2329"
                                      BorderThickness="0"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      Cursor="Hand"
                                      Click="OnCandleStyleChanged"/>
                    </StackPanel>
                </Border>
                
                <!-- 第4列：工具图标（右侧） -->
                <StackPanel Grid.Column="3" 
                            Orientation="Horizontal" 
                            Spacing="8"
                            HorizontalAlignment="Right">
                    <!-- 主图指标 -->
                    <Button x:Name="BtnIndicator" 
                            Width="32" Height="32"
                            Padding="0"
                            CornerRadius="8"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Cursor="Hand"
                            Click="OnIndicatorClick"
                            ToolTip.Tip="主图指标">
                        <PathIcon Data="{StaticResource IconIndicator}" 
                                  Width="18" Height="18"
                                  Foreground="{DynamicResource Text1Brush}"/>
                    </Button>
                    
                    <!-- 副图 -->
                    <Button x:Name="BtnSubChart" 
                            Width="32" Height="32"
                            Padding="0"
                            CornerRadius="8"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Cursor="Hand"
                            Click="OnSubChartClick"
                            ToolTip.Tip="副图">
                        <PathIcon Data="{StaticResource IconSubChart}" 
                                  Width="18" Height="18"
                                  Foreground="{DynamicResource Text1Brush}"/>
                    </Button>
                    
                    <!-- 画线工具 -->
                    <Button x:Name="BtnDrawLine" 
                            Width="32" Height="32"
                            Padding="0"
                            CornerRadius="8"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Cursor="Hand"
                            ToolTip.Tip="画线工具">
                        <PathIcon Data="{StaticResource IconDrawLine}" 
                                  Width="18" Height="18"
                                  Foreground="{DynamicResource Text1Brush}"/>
                    </Button>
                    
                    <!-- 设置 -->
                    <Button x:Name="BtnSettings" 
                            Width="32" Height="32"
                            Padding="0"
                            CornerRadius="8"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Cursor="Hand"
                            ToolTip.Tip="设置">
                        <PathIcon Data="{StaticResource IconSettings}" 
                                  Width="18" Height="18"
                                  Foreground="{DynamicResource Text1Brush}"/>
                    </Button>
                </StackPanel>
                
            </Grid>
        </Border>
        
        <!-- K线图和副图（统一Canvas） -->
        <Border Grid.Row="2"
                Margin="10"
                Background="{DynamicResource Background2Brush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0"
                CornerRadius="8"
                Padding="0">
            <controls:CandlestickChart x:Name="MainChart"/>
        </Border>
        
    </Grid>
    
</UserControl>
