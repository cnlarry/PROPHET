                                </Grid>
                                <CheckBox x:Name="ChkShowMTMMA" Content="显示MTM均线" FontSize="12" Foreground="{DynamicResource Text2Brush}" IsChecked="False"/>
                                <StackPanel Spacing="8"><TextBlock Text="MA线1" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text2Brush}"/><Grid ColumnDefinitions="Auto,*,80"><CheckBox Grid.Column="0" x:Name="ChkMTMMA1" IsChecked="True" Content="启用" FontSize="11" Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Center"/><Grid Grid.Column="1" ColumnDefinitions="Auto,*" Margin="10,0,10,0"><TextBlock Grid.Column="0" Text="周期" FontSize="11" Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Center" Margin="0,0,5,0"/><NumericUpDown Grid.Column="1" x:Name="NumMTMMA1Period" Value="5" Minimum="1" Maximum="200" Height="28"/></Grid><Border Grid.Column="2" x:Name="ColorMTMMA1" Background="#FFD700" CornerRadius="4" Height="28"/></Grid></StackPanel>
                                <StackPanel Spacing="8"><TextBlock Text="MA线2" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text2Brush}"/><Grid ColumnDefinitions="Auto,*,80"><CheckBox Grid.Column="0" x:Name="ChkMTMMA2" IsChecked="True" Content="启用" FontSize="11" Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Center"/><Grid Grid.Column="1" ColumnDefinitions="Auto,*" Margin="10,0,10,0"><TextBlock Grid.Column="0" Text="周期" FontSize="11" Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Center" Margin="0,0,5,0"/><NumericUpDown Grid.Column="1" x:Name="NumMTMMA2Period" Value="10" Minimum="1" Maximum="200" Height="28"/></Grid><Border Grid.Column="2" x:Name="ColorMTMMA2" Background="#00FFFF" CornerRadius="4" Height="28"/></Grid></StackPanel>
                                <StackPanel Spacing="8"><TextBlock Text="MA线3" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text2Brush}"/><Grid ColumnDefinitions="Auto,*,80"><CheckBox Grid.Column="0" x:Name="ChkMTMMA3" IsChecked="False" Content="启用" FontSize="11" Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Center"/><Grid Grid.Column="1" ColumnDefinitions="Auto,*" Margin="10,0,10,0"><TextBlock Grid.Column="0" Text="周期" FontSize="11" Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Center" Margin="0,0,5,0"/><NumericUpDown Grid.Column="1" x:Name="NumMTMMA3Period" Value="20" Minimum="1" Maximum="200" Height="28"/></Grid><Border Grid.Column="2" x:Name="ColorMTMMA3" Background="#FF00FF" CornerRadius="4" Height="28"/></Grid></StackPanel>
                            </StackPanel>
                            
                            <!-- CMO配置面板 -->
                            <StackPanel x:Name="CMOConfigPanel" Spacing="15" IsVisible="False">
                                <TextBlock Text="CMO - Chande动量振荡器"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text1Brush}"/>
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Column="0" Text="周期" FontSize="12" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center" Width="80"/>
                                    <NumericUpDown Grid.Column="1" x:Name="NumCMOPeriod" Value="14" Minimum="1" Maximum="100" Height="32" Margin="10,0,0,0"/>
                                </Grid>
                                <CheckBox x:Name="ChkShowCMOMA" Content="显示CMO均线" FontSize="12" Foreground="{DynamicResource Text2Brush}" IsChecked="False"/>
                                <StackPanel Spacing="8"><TextBlock Text="MA线1" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text2Brush}"/><Grid ColumnDefinitions="Auto,*,80"><CheckBox Grid.Column="0" x:Name="ChkCMOMA1" IsChecked="True" Content="启用" FontSize="11" Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Center"/><Grid Grid.Column="1" ColumnDefinitions="Auto,*" Margin="10,0,10,0"><TextBlock Grid.Column="0" Text="周期" FontSize="11" Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Center" Margin="0,0,5,0"/><NumericUpDown Grid.Column="1" x:Name="NumCMOMA1Period" Value="5" Minimum="1" Maximum="200" Height="28"/></Grid><Border Grid.Column="2" x:Name="ColorCMOMA1" Background="#FFD700" CornerRadius="4" Height="28"/></Grid></StackPanel>
                                <StackPanel Spacing="8"><TextBlock Text="MA线2" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text2Brush}"/><Grid ColumnDefinitions="Auto,*,80"><CheckBox Grid.Column="0" x:Name="ChkCMOMA2" IsChecked="True" Content="启用" FontSize="11" Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Center"/><Grid Grid.Column="1" ColumnDefinitions="Auto,*" Margin="10,0,10,0"><TextBlock Grid.Column="0" Text="周期" FontSize="11" Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Center" Margin="0,0,5,0"/><NumericUpDown Grid.Column="1" x:Name="NumCMOMA2Period" Value="10" Minimum="1" Maximum="200" Height="28"/></Grid><Border Grid.Column="2" x:Name="ColorCMOMA2" Background="#00FFFF" CornerRadius="4" Height="28"/></Grid></StackPanel>
                                <StackPanel Spacing="8"><TextBlock Text="MA线3" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text2Brush}"/><Grid ColumnDefinitions="Auto,*,80"><CheckBox Grid.Column="0" x:Name="ChkCMOMA3" IsChecked="False" Content="启用" FontSize="11" Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Center"/><Grid Grid.Column="1" ColumnDefinitions="Auto,*" Margin="10,0,10,0"><TextBlock Grid.Column="0" Text="周期" FontSize="11" Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Center" Margin="0,0,5,0"/><NumericUpDown Grid.Column="1" x:Name="NumCMOMA3Period" Value="20" Minimum="1" Maximum="200" Height="28"/></Grid><Border Grid.Column="2" x:Name="ColorCMOMA3" Background="#FF00FF" CornerRadius="4" Height="28"/></Grid></StackPanel>
                            </StackPanel>
                            
                            <!-- Aroon配置面板 -->
                            <StackPanel x:Name="AroonConfigPanel" Spacing="15" IsVisible="False">
                                <TextBlock Text="Aroon - 阿隆指标"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text1Brush}"/>
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Column="0" Text="周期" FontSize="12" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center" Width="80"/>
                                    <NumericUpDown Grid.Column="1" x:Name="NumAroonPeriod" Value="25" Minimum="1" Maximum="100" Height="32" Margin="10,0,0,0"/>
                                </Grid>
                            </StackPanel>
                            
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                
            </Grid>
            
            <!-- 第三行：底部按钮栏 -->
            <Border Grid.Row="2"
                    Background="{DynamicResource Background2Brush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,8,8"
                    Padding="20,15">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                    <Button Grid.Column="1"
                            x:Name="CancelButton"
                            Content="取消"
                            Width="100"
                            Height="36"
                            FontSize="13"
                            Margin="0,0,10,0"
                            Background="{DynamicResource Background2Brush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Cursor="Hand"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Click="CancelButton_OnClick"/>
                    <Button Grid.Column="2"
                            x:Name="ApplyButton"
                            Content="应用"
                            Width="100"
                            Height="36"
                            FontSize="13"
                            Margin="0,0,10,0"
                            Background="{DynamicResource Background2Brush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Cursor="Hand"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Click="ApplyButton_OnClick"/>
                    <Button Grid.Column="3"
                            x:Name="ConfirmButton"
                            Content="确定"
                            Width="100"
                            Height="36"
                            FontSize="13"
                            Background="#F0B90B"
                            Foreground="#FFFFFF"
                            BorderThickness="0"
                            CornerRadius="6"
                            Cursor="Hand"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Click="ConfirmButton_OnClick"/>
                </Grid>
            </Border>
            
        </Grid>
    </Border>
</UserControl>
