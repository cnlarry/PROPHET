<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="450"
             x:Class="Prophet.Client.Views.Dialogs.StrategyDeprecationDialog">
    
    <UserControl.Styles>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="#F0B90B"/>
        </Style>
        
        <Style Selector="Button.Warning">
            <Setter Property="Background" Value="#FF9800"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
        </Style>
        
        <Style Selector="Button.Warning:pointerover">
            <Setter Property="Background" Value="#FFB74D"/>
        </Style>
        
        <Style Selector="Button.Secondary">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
        </Style>
        
        <Style Selector="Button.Secondary:pointerover">
            <Setter Property="Background" Value="#3A3A3A"/>
        </Style>
    </UserControl.Styles>
    
    <Grid RowDefinitions="Auto,*,Auto" Margin="24">
        <!-- 标题 -->
        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock Text="⚠️ 废弃策略"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#D4D4D4"/>
            <TextBlock Name="StrategyNameText"
                       FontSize="14"
                       Foreground="#A0A0A0"/>
        </StackPanel>
        
        <!-- 主内容区域 -->
        <ScrollViewer Grid.Row="1" Margin="0,24,0,0">
            <StackPanel Spacing="20">
                <!-- 说明文本 -->
                <TextBlock TextWrapping="Wrap"
                           Foreground="#D4D4D4"
                           FontSize="13">
                    确认要废弃此策略吗？
                </TextBlock>
                
                <!-- 废弃后的说明 -->
                <Border Background="#2A2A2A"
                        BorderBrush="#3F3F46"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="废弃后："
                                   Foreground="#A0A0A0"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="• 已订阅用户可继续使用"
                                   Foreground="#A0A0A0"
                                   FontSize="12"/>
                        <TextBlock Text="• 新用户不能订阅此策略"
                                   Foreground="#A0A0A0"
                                   FontSize="12"/>
                        <TextBlock Text="• 策略作者可以将其归档"
                                   Foreground="#A0A0A0"
                                   FontSize="12"/>
                    </StackPanel>
                </Border>
                
                <!-- 废弃原因输入 -->
                <StackPanel Spacing="8">
                    <TextBlock Text="废弃原因（必填）："
                               Foreground="#D4D4D4"
                               FontSize="13"
                               FontWeight="Medium"/>
                    <TextBox Name="ReasonTextBox"
                             Watermark="请输入废弃原因，例如：发现在震荡市场中频繁止损..."
                             MinHeight="100"
                             MaxHeight="150"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"/>
                </StackPanel>
                
                <!-- 订阅者数量提示 -->
                <Border Background="#2A211F"
                        BorderBrush="#FF9800"
                        BorderThickness="2,0,0,0"
                        CornerRadius="4"
                        Padding="12"
                        Name="SubscriberWarning">
                    <StackPanel Spacing="4">
                        <TextBlock Name="SubscriberCountText"
                                   Foreground="#FFB74D"
                                   FontSize="12"/>
                        <TextBlock Text="建议在废弃原因中说明替代方案或建议。"
                                   Foreground="#A0A0A0"
                                   FontSize="11"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        
        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="12"
                    Margin="0,24,0,0">
            <Button Name="CancelButton"
                    Content="取消"
                    Width="100"
                    Classes="Secondary"
                    Click="OnCancelClick"/>
            
            <Button Name="ConfirmButton"
                    Content="确认废弃"
                    Width="120"
                    Classes="Warning"
                    Click="OnConfirmClick"/>
        </StackPanel>
    </Grid>
</UserControl>

