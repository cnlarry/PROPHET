                                        <TextBox x:Name="TxtTEMA1Period" Grid.Column="1" Text="7" FontSize="11" Height="26" Padding="8,0" VerticalContentAlignment="Center" Margin="12,0,0,0" Width="70"/>
                                        <ComboBox x:Name="CmbTEMA1Field" Grid.Column="2" FontSize="11" Height="26" SelectedIndex="3" Margin="12,0,0,0" Width="90">
                                            <ComboBoxItem Content="开盘"/><ComboBoxItem Content="最高"/><ComboBoxItem Content="最低"/><ComboBoxItem Content="收盘"/>
                                        </ComboBox>
                                        <ComboBox x:Name="CmbTEMA1Style" Grid.Column="3" FontSize="11" Height="26" SelectedIndex="0" Margin="12,0,0,0" Width="120">
                                            <ComboBoxItem><Canvas Width="60" Height="16"><Line StartPoint="0,8" EndPoint="60,8" Stroke="{DynamicResource Text1Brush}" StrokeThickness="2"/></Canvas></ComboBoxItem>
                                            <ComboBoxItem><Canvas Width="60" Height="16"><Line StartPoint="0,8" EndPoint="60,8" Stroke="{DynamicResource Text1Brush}" StrokeThickness="2" StrokeDashArray="2,2"/></Canvas></ComboBoxItem>
                                            <ComboBoxItem><Canvas Width="60" Height="16"><Line StartPoint="0,8" EndPoint="60,8" Stroke="{DynamicResource Text1Brush}" StrokeThickness="2" StrokeDashArray="4,3"/></Canvas></ComboBoxItem>
                                            <ComboBoxItem><Canvas Width="60" Height="16"><Line StartPoint="0,8" EndPoint="60,8" Stroke="{DynamicResource Text1Brush}" StrokeThickness="2" StrokeDashArray="1,1"/></Canvas></ComboBoxItem>
                                        </ComboBox>
                                        <Button x:Name="BtnTEMA1Color" Grid.Column="4" Width="56" Height="26" Padding="0" Background="#FF0000" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Cursor="Hand" Margin="15,0,0,0" Click="OnColorButtonClick"/>
                                    </Grid>
                                    
                                    <!-- TEMA2 -->
                                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto">
                                        <CheckBox x:Name="ChkTEMA2" Grid.Column="0" Content="TEMA2" IsChecked="False" FontSize="11" Foreground="{DynamicResource Text1Brush}" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtTEMA2Period" Grid.Column="1" Text="25" FontSize="11" Height="26" Padding="8,0" VerticalContentAlignment="Center" Margin="12,0,0,0" Width="70"/>
                                        <ComboBox x:Name="CmbTEMA2Field" Grid.Column="2" FontSize="11" Height="26" SelectedIndex="3" Margin="12,0,0,0" Width="90">
                                            <ComboBoxItem Content="开盘"/><ComboBoxItem Content="最高"/><ComboBoxItem Content="最低"/><ComboBoxItem Content="收盘"/>
                                        </ComboBox>
                                        <ComboBox x:Name="CmbTEMA2Style" Grid.Column="3" FontSize="11" Height="26" SelectedIndex="0" Margin="12,0,0,0" Width="120">
                                            <ComboBoxItem><Canvas Width="60" Height="16"><Line StartPoint="0,8" EndPoint="60,8" Stroke="{DynamicResource Text1Brush}" StrokeThickness="2"/></Canvas></ComboBoxItem>
                                            <ComboBoxItem><Canvas Width="60" Height="16"><Line StartPoint="0,8" EndPoint="60,8" Stroke="{DynamicResource Text1Brush}" StrokeThickness="2" StrokeDashArray="2,2"/></Canvas></ComboBoxItem>
                                            <ComboBoxItem><Canvas Width="60" Height="16"><Line StartPoint="0,8" EndPoint="60,8" Stroke="{DynamicResource Text1Brush}" StrokeThickness="2" StrokeDashArray="4,3"/></Canvas></ComboBoxItem>
                                            <ComboBoxItem><Canvas Width="60" Height="16"><Line StartPoint="0,8" EndPoint="60,8" Stroke="{DynamicResource Text1Brush}" StrokeThickness="2" StrokeDashArray="1,1"/></Canvas></ComboBoxItem>
                                        </ComboBox>
                                        <Button x:Name="BtnTEMA2Color" Grid.Column="4" Width="56" Height="26" Padding="0" Background="#FFD700" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Cursor="Hand" Click="OnColorButtonClick" Margin="15,0,0,0"/>
                                    </Grid>
                                    
                                    <!-- TEMA3 -->
                                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto">
                                        <CheckBox x:Name="ChkTEMA3" Grid.Column="0" Content="TEMA3" IsChecked="False" FontSize="11" Foreground="{DynamicResource Text1Brush}" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtTEMA3Period" Grid.Column="1" Text="99" FontSize="11" Height="26" Padding="8,0" VerticalContentAlignment="Center" Margin="12,0,0,0" Width="70"/>
                                        <ComboBox x:Name="CmbTEMA3Field" Grid.Column="2" FontSize="11" Height="26" SelectedIndex="3" Margin="12,0,0,0" Width="90">
                                            <ComboBoxItem Content="开盘"/><ComboBoxItem Content="最高"/><ComboBoxItem Content="最低"/><ComboBoxItem Content="收盘"/>
                                        </ComboBox>
                                        <ComboBox x:Name="CmbTEMA3Style" Grid.Column="3" FontSize="11" Height="26" SelectedIndex="0" Margin="12,0,0,0" Width="120">
                                            <ComboBoxItem><Canvas Width="60" Height="16"><Line StartPoint="0,8" EndPoint="60,8" Stroke="{DynamicResource Text1Brush}" StrokeThickness="2"/></Canvas></ComboBoxItem>
                                            <ComboBoxItem><Canvas Width="60" Height="16"><Line StartPoint="0,8" EndPoint="60,8" Stroke="{DynamicResource Text1Brush}" StrokeThickness="2" StrokeDashArray="2,2"/></Canvas></ComboBoxItem>
                                            <ComboBoxItem><Canvas Width="60" Height="16"><Line StartPoint="0,8" EndPoint="60,8" Stroke="{DynamicResource Text1Brush}" StrokeThickness="2" StrokeDashArray="4,3"/></Canvas></ComboBoxItem>
                                            <ComboBoxItem><Canvas Width="60" Height="16"><Line StartPoint="0,8" EndPoint="60,8" Stroke="{DynamicResource Text1Brush}" StrokeThickness="2" StrokeDashArray="1,1"/></Canvas></ComboBoxItem>
                                        </ComboBox>
                                        <Button x:Name="BtnTEMA3Color" Grid.Column="4" Width="56" Height="26" Padding="0" Background="#FF00FF" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Cursor="Hand" Click="OnColorButtonClick" Margin="15,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                            
                            <!-- Keltner配置面板 -->
                            <StackPanel x:Name="KeltnerConfigPanel" Spacing="16" IsVisible="False">
                                <TextBlock Text="Keltner Channel - 肯特纳通道"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text1Brush}"/>
                                
                                <TextBlock Text="基于ATR的波动通道，显示上轨、中线、下轨。与布林带搭配使用效果更佳。"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text2Brush}"
                                           TextWrapping="Wrap"
                                           Margin="0,-8,0,0"/>
                                
                                <!-- 周期 -->
                                <StackPanel Spacing="6">
                                    <TextBlock Text="周期" FontSize="11" Foreground="{DynamicResource Text2Brush}"/>
                                    <TextBox x:Name="TxtKeltnerPeriod" Text="20" FontSize="12" Height="30" Padding="10,0" VerticalContentAlignment="Center"/>
                                </StackPanel>
                                
                                <!-- ATR倍数 -->
                                <StackPanel Spacing="6">
                                    <TextBlock Text="ATR倍数" FontSize="11" Foreground="{DynamicResource Text2Brush}"/>
                                    <TextBox x:Name="TxtKeltnerMultiplier" Text="2.0" FontSize="12" Height="30" Padding="10,0" VerticalContentAlignment="Center"/>
                                </StackPanel>
                                
                                <!-- 颜色配置 -->
                                <StackPanel Spacing="10">
                                    <TextBlock Text="颜色配置" FontSize="11" Foreground="{DynamicResource Text2Brush}"/>
                                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto">
                                        <!-- 上轨 -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="上轨：" FontSize="11" Foreground="{DynamicResource Text1Brush}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                                        <Button x:Name="BtnKeltnerUpperColor" Grid.Row="0" Grid.Column="2" Width="70" Height="26" Padding="0" Background="#26A69A" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Cursor="Hand" Click="OnColorButtonClick" Margin="0,0,0,8"/>
                                        
                                        <!-- 中线 -->
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="中线：" FontSize="11" Foreground="{DynamicResource Text1Brush}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                                        <Button x:Name="BtnKeltnerMiddleColor" Grid.Row="1" Grid.Column="2" Width="70" Height="26" Padding="0" Background="#2196F3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Cursor="Hand" Click="OnColorButtonClick" Margin="0,0,0,8"/>
                                        
                                        <!-- 下轨 -->
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="下轨：" FontSize="11" Foreground="{DynamicResource Text1Brush}" VerticalAlignment="Center"/>
                                        <Button x:Name="BtnKeltnerLowerColor" Grid.Row="2" Grid.Column="2" Width="70" Height="26" Padding="0" Background="#EF5350" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Cursor="Hand" Click="OnColorButtonClick"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                            
                            <!-- Ichimoku配置面板 -->
                            <StackPanel x:Name="IchimokuConfigPanel" Spacing="16" IsVisible="False">
                                <TextBlock Text="Ichimoku Cloud - 一目均衡表"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text1Brush}"/>
                                
                                <TextBlock Text="专业级综合指标，包含转换线、基准线、先行带A/B、延迟线和云图。"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text2Brush}"
                                           TextWrapping="Wrap"
                                           Margin="0,-8,0,0"/>
                                
                                <TextBlock Text="组成: 转换线(9)、基准线(26)、先行带A/B、延迟线、云图填充"
                                           FontSize="11"
                                           Foreground="{DynamicResource Text2Brush}"
                                           TextWrapping="Wrap"/>
                                
                                <!-- 周期配置 -->
                                <StackPanel Spacing="10">
                                    <TextBlock Text="周期配置" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text2Brush}"/>
                                    
                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                                        <!-- 转换线周期 -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="转换线周期：" FontSize="11" Foreground="{DynamicResource Text1Brush}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                                        <TextBox x:Name="TxtIchimokuTenkan" Grid.Row="0" Grid.Column="1" Text="9" FontSize="12" Height="30" Padding="10,0" VerticalContentAlignment="Center" Margin="0,0,0,8" Width="120" HorizontalAlignment="Left"/>
                                        
                                        <!-- 基准线周期 -->
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="基准线周期：" FontSize="11" Foreground="{DynamicResource Text1Brush}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                                        <TextBox x:Name="TxtIchimokuKijun" Grid.Row="1" Grid.Column="1" Text="26" FontSize="12" Height="30" Padding="10,0" VerticalContentAlignment="Center" Margin="0,0,0,8" Width="120" HorizontalAlignment="Left"/>
                                        
                                        <!-- 先行带B周期 -->
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="先行带B周期：" FontSize="11" Foreground="{DynamicResource Text1Brush}" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtIchimokuSenkouB" Grid.Row="2" Grid.Column="1" Text="52" FontSize="12" Height="30" Padding="10,0" VerticalContentAlignment="Center" Width="120" HorizontalAlignment="Left"/>
                                    </Grid>
                                </StackPanel>
                                
                                <!-- 颜色配置 -->
                                <StackPanel Spacing="10">
                                    <TextBlock Text="颜色配置" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text2Brush}"/>
                                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                                        <!-- 转换线 -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="转换线：" FontSize="11" Foreground="{DynamicResource Text1Brush}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                                        <Button x:Name="BtnIchimokuTenkanColor" Grid.Row="0" Grid.Column="2" Width="70" Height="26" Padding="0" Background="#F44336" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Cursor="Hand" Click="OnColorButtonClick" Margin="0,0,0,8"/>
                                        
                                        <!-- 基准线 -->
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="基准线：" FontSize="11" Foreground="{DynamicResource Text1Brush}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                                        <Button x:Name="BtnIchimokuKijunColor" Grid.Row="1" Grid.Column="2" Width="70" Height="26" Padding="0" Background="#2196F3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Cursor="Hand" Click="OnColorButtonClick" Margin="0,0,0,8"/>
                                        
                                        <!-- 看涨云图 -->
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="看涨云图：" FontSize="11" Foreground="{DynamicResource Text1Brush}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                                        <Button x:Name="BtnIchimokuCloudBullishColor" Grid.Row="2" Grid.Column="2" Width="70" Height="26" Padding="0" Background="#4CAF50" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Cursor="Hand" Click="OnColorButtonClick" Margin="0,0,0,8"/>
                                        
                                        <!-- 看跌云图 -->
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="看跌云图：" FontSize="11" Foreground="{DynamicResource Text1Brush}" VerticalAlignment="Center"/>
                                        <Button x:Name="BtnIchimokuCloudBearishColor" Grid.Row="3" Grid.Column="2" Width="70" Height="26" Padding="0" Background="#EF5350" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Cursor="Hand" Click="OnColorButtonClick"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
            
            <!-- 底部按钮 -->
            <Border Grid.Row="2"
                    Background="{DynamicResource Background2Brush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,8,8"
                    Padding="20,10">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                    <Button Grid.Column="1"
                            x:Name="CancelButton"
                            Content="取消"
                            Width="100"
                            Height="36"
                            FontSize="13"
                            Margin="0,0,10,0"
                            Background="{DynamicResource Background2Brush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Cursor="Hand"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Click="CancelButton_OnClick"/>
                    <Button Grid.Column="2"
                            x:Name="ResetButton"
                            Content="重置"
                            Width="100"
                            Height="36"
                            FontSize="13"
                            Margin="0,0,10,0"
                            Background="{DynamicResource Background2Brush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Cursor="Hand"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Click="ResetButton_OnClick"/>
                    <Button Grid.Column="3"
                            x:Name="ConfirmButton"
                            Content="确定"
                            Width="100"
                            Height="36"
                            FontSize="13"
                            Background="#F0B90B"
                            Foreground="#FFFFFF"
                            BorderThickness="0"
                            CornerRadius="6"
                            Cursor="Hand"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Click="ConfirmButton_OnClick"/>
                </Grid>
            </Border>
            
        </Grid>
    </Border>
</UserControl>


