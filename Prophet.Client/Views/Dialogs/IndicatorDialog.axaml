<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="660" d:DesignHeight="550"
             x:Class="Prophet.Client.Views.Dialogs.IndicatorDialog">
    
    <Border Background="{DynamicResource Background2Brush}"
            BorderBrush="Transparent"
            BorderThickness="0"
            CornerRadius="8"
            Padding="0">
        
        <Grid RowDefinitions="Auto,*,Auto">
            
            <!-- 标题栏 -->
            <Border Grid.Row="0"
                    Background="{DynamicResource Background2Brush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="8,8,0,0"
                    Padding="20,10">
                <Grid ColumnDefinitions="*,Auto">
                    <!-- 标题和图标 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                        <PathIcon Data="{StaticResource IconIndicator}" 
                                  Width="18" 
                                  Height="18" 
                                  Foreground="{DynamicResource Text1Brush}"
                                  VerticalAlignment="Center"/>
                        <TextBlock Text="主图指标"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text1Brush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <!-- 关闭按钮 -->
                    <Button Grid.Column="1"
                            x:Name="CloseButton"
                            Content="✕"
                            Width="28"
                            Height="28"
                            Padding="0"
                            FontSize="16"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource Text2Brush}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Cursor="Hand"
                            Click="CloseButton_OnClick"/>
                </Grid>
            </Border>
            
            <!-- 内容区域：左右分栏布局 -->
            <Grid Grid.Row="1" ColumnDefinitions="150,*" Margin="0">
                
                <!-- 左侧：指标列表 -->
                <Border Grid.Column="0"
                        Background="{DynamicResource Background2Brush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,1,0"
                        CornerRadius="0"
                        Padding="0"
                        Margin="0">
                    <ScrollViewer>
                        <StackPanel Spacing="0">
                            <!-- MA -->
                            <Border x:Name="BtnMA"
                                    Background="Transparent"
                                    Padding="16,5"
                                    Cursor="Hand"
                                    PointerPressed="OnIndicatorSelected">
                                <CheckBox x:Name="ChkMA"
                                          Content="MA"
                                          FontSize="13"
                                          Foreground="{DynamicResource Text1Brush}"
                                          IsChecked="True"/>
                            </Border>
                            
                            <!-- EMA -->
                            <Border x:Name="BtnEMA"
                                    Background="Transparent"
                                    Padding="16,5"
                                    Cursor="Hand"
                                    PointerPressed="OnIndicatorSelected">
                                <CheckBox x:Name="ChkEMA"
                                          Content="EMA"
                                          FontSize="13"
                                          Foreground="{DynamicResource Text1Brush}"
                                          IsChecked="True"
                                          />
                            </Border>
                            
                            <!-- WMA -->
                            <Border x:Name="BtnWMA"
                                    Background="Transparent"
                                    Padding="16,5"
                                    Cursor="Hand"
                                    PointerPressed="OnIndicatorSelected">
                                <CheckBox x:Name="ChkWMA"
                                          Content="WMA"
                                          FontSize="13"
                                          Foreground="{DynamicResource Text1Brush}"
                                          IsChecked="True"
                                          />
                            </Border>
                            
                            <!-- BOLL -->
                            <Border x:Name="BtnBOLL"
                                    Background="Transparent"
                                    Padding="16,5"
                                    Cursor="Hand"
                                    PointerPressed="OnIndicatorSelected">
                                <CheckBox x:Name="ChkBOLL"
                                          Content="BOLL"
                                          FontSize="13"
                                          Foreground="{DynamicResource Text1Brush}"
                                          />
                            </Border>
                            
                            <!-- VWAP -->
                            <Border x:Name="BtnVWAP"
                                    Background="Transparent"
                                    Padding="16,5"
                                    Cursor="Hand"
                                    PointerPressed="OnIndicatorSelected">
                                <CheckBox x:Name="ChkVWAP"
                                          Content="VWAP"
                                          FontSize="13"
                                          Foreground="{DynamicResource Text1Brush}"
                                          />
                            </Border>
                            
                            <!-- DEMA -->
                            <Border x:Name="BtnDEMA"
                                    Background="Transparent"
                                    Padding="16,5"
                                    Cursor="Hand"
                                    PointerPressed="OnIndicatorSelected">
                                <CheckBox x:Name="ChkDEMA"
                                          Content="DEMA"
                                          FontSize="13"
                                          Foreground="{DynamicResource Text1Brush}"
                                          />
                            </Border>
                            
                            <!-- TEMA -->
                            <Border x:Name="BtnTEMA"
                                    Background="Transparent"
                                    Padding="16,5"
                                    Cursor="Hand"
                                    PointerPressed="OnIndicatorSelected">
                                <CheckBox x:Name="ChkTEMA"
                                          Content="TEMA"
                                          FontSize="13"
                                          Foreground="{DynamicResource Text1Brush}"
                                          />
                            </Border>
                            
                            <!-- Keltner Channel -->
                            <Border x:Name="BtnKeltner"
                                    Background="Transparent"
                                    Padding="16,5"
                                    Cursor="Hand"
                                    PointerPressed="OnIndicatorSelected">
                                <CheckBox x:Name="ChkKeltner"
                                          Content="Keltner"
                                          FontSize="13"
                                          Foreground="{DynamicResource Text1Brush}"
                                          />
                            </Border>
                            
                            <!-- Ichimoku Cloud -->
                            <Border x:Name="BtnIchimoku"
                                    Background="Transparent"
                                    Padding="16,5"
                                    Cursor="Hand"
                                    PointerPressed="OnIndicatorSelected">
                                <CheckBox x:Name="ChkIchimoku"
                                          Content="Ichimoku"
                                          FontSize="13"
                                          Foreground="{DynamicResource Text1Brush}"
                                          />
                            </Border>
                            
                            <!-- SAR -->
                            <Border x:Name="BtnSAR"
                                    Background="Transparent"
                                    Padding="16,5"
                                    Cursor="Hand"
                                    PointerPressed="OnIndicatorSelected">
                                <CheckBox x:Name="ChkSAR"
                                          Content="SAR"
                                          FontSize="13"
                                          Foreground="{DynamicResource Text1Brush}"
                                          />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                
                <!-- 右侧：参数配置区 -->
                <Border Grid.Column="1"
                        Background="{DynamicResource Background2Brush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0"
                        CornerRadius="0"
                        Padding="20">
                    <ScrollViewer>
                        <StackPanel x:Name="ConfigPanel" Spacing="16">
                            <!-- 动态内容区域，根据选中的指标显示不同的配置 -->
                            <TextBlock x:Name="NoSelectionText"
                                       Text="← 请在左侧选择一个指标进行配置"
                                       FontSize="13"
                                       Foreground="{DynamicResource Text3Brush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,40,0,0"/>
                            
                            <!-- MA配置面板 -->
                            <StackPanel x:Name="MAConfigPanel" Spacing="10" IsVisible="True">
                                <TextBlock Text="MA - 移动平均线"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text1Brush}"/>
                                
                                <StackPanel Spacing="15">
                                    <!-- MA1 -->
                                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto">
                                        <CheckBox x:Name="ChkMA1" Grid.Column="0" Content="MA1" IsChecked="True" FontSize="11" Foreground="{DynamicResource Text1Brush}" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtMA1Period" Grid.Column="1" Text="7" FontSize="11" Height="26" Padding="8,0" VerticalContentAlignment="Center" Margin="12,0,0,0" Width="70"/>
                                        <ComboBox x:Name="CmbMA1Field" Grid.Column="2" FontSize="11" Height="26" SelectedIndex="3" Margin="12,0,0,0" Width="90">
                                            <ComboBoxItem Content="开盘"/>
                                            <ComboBoxItem Content="最高"/>
                                            <ComboBoxItem Content="最低"/>
                                            <ComboBoxItem Content="收盘"/>
                                        </ComboBox>
                                        <ComboBox x:Name="CmbMA1Style" Grid.Column="3" FontSize="11" Height="26" SelectedIndex="0" Margin="12,0,0,0" Width="120">
                                            <ComboBoxItem>
                                                <Canvas Width="60" Height="16">
                                                    <Line StartPoint="0,8" EndPoint="60,8" Stroke="{DynamicResource Text1Brush}" StrokeThickness="2"/>
                                                </Canvas>
                                            </ComboBoxItem>
                                            <ComboBoxItem>
                                                <Canvas Width="60" Height="16">
                                                    <Line StartPoint="0,8" EndPoint="60,8" Stroke="{DynamicResource Text1Brush}" StrokeThickness="2" StrokeDashArray="2,2"/>
                                                </Canvas>
                                            </ComboBoxItem>
                                            <ComboBoxItem>
                                                <Canvas Width="60" Height="16">
                                                    <Line StartPoint="0,8" EndPoint="60,8" Stroke="{DynamicResource Text1Brush}" StrokeThickness="2" StrokeDashArray="4,3"/>
                                                </Canvas>
                                            </ComboBoxItem>
                                            <ComboBoxItem>
                                                <Canvas Width="60" Height="16">
                                                    <Line StartPoint="0,8" EndPoint="60,8" Stroke="{DynamicResource Text1Brush}" StrokeThickness="2" StrokeDashArray="1,1"/>
                                                </Canvas>
                                            </ComboBoxItem>
                                        </ComboBox>
                                        <Button x:Name="BtnMA1Color" Grid.Column="4" Width="56" Height="26" Padding="0" Background="#FFFFFF" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Cursor="Hand" Margin="15,0,0,0" Click="OnColorButtonClick"/>
                                    </Grid>
                                    
                                    <!-- MA2 -->
                                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto">
                                        <CheckBox x:Name="ChkMA2" Grid.Column="0" Content="MA2" IsChecked="True" FontSize="11" Foreground="{DynamicResource Text1Brush}" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtMA2Period" Grid.Column="1" Text="25" FontSize="11" Height="26" Padding="8,0" VerticalContentAlignment="Center" Margin="12,0,0,0" Width="70"/>
                                        <ComboBox x:Name="CmbMA2Field" Grid.Column="2" FontSize="11" Height="26" SelectedIndex="3" Margin="12,0,0,0" Width="90">
                                            <ComboBoxItem Content="开盘"/><ComboBoxItem Content="最高"/><ComboBoxItem Content="最低"/><ComboBoxItem Content="收盘"/>
                                        </ComboBox>
                                        <ComboBox x:Name="CmbMA2Style" Grid.Column="3" FontSize="11" Height="26" SelectedIndex="0" Margin="12,0,0,0" Width="120">
                                            <ComboBoxItem><Canvas Width="60" Height="16"><Line StartPoint="0,8" EndPoint="60,8" Stroke="{DynamicResource Text1Brush}" StrokeThickness="2"/></Canvas></ComboBoxItem>
                                            <ComboBoxItem><Canvas Width="60" Height="16"><Line StartPoint="0,8" EndPoint="60,8" Stroke="{DynamicResource Text1Brush}" StrokeThickness="2" StrokeDashArray="2,2"/></Canvas></ComboBoxItem>
                                            <ComboBoxItem><Canvas Width="60" Height="16"><Line StartPoint="0,8" EndPoint="60,8" Stroke="{DynamicResource Text1Brush}" StrokeThickness="2" StrokeDashArray="4,3"/></Canvas></ComboBoxItem>
                                            <ComboBoxItem><Canvas Width="60" Height="16"><Line StartPoint="0,8" EndPoint="60,8" Stroke="{DynamicResource Text1Brush}" StrokeThickness="2" StrokeDashArray="1,1"/></Canvas></ComboBoxItem>
                                        </ComboBox>
                                        <Button x:Name="BtnMA2Color" Grid.Column="4" Width="56" Height="26" Padding="0" Background="#FFD700" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Cursor="Hand" Click="OnColorButtonClick" Margin="15,0,0,0"/>
                                    </Grid>
                                    
                                    <!-- MA3 -->
                                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto">
                                        <CheckBox x:Name="ChkMA3" Grid.Column="0" Content="MA3" IsChecked="True" FontSize="11" Foreground="{DynamicResource Text1Brush}" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtMA3Period" Grid.Column="1" Text="99" FontSize="11" Height="26" Padding="8,0" VerticalContentAlignment="Center" Margin="12,0,0,0" Width="70"/>
                                        <ComboBox x:Name="CmbMA3Field" Grid.Column="2" FontSize="11" Height="26" SelectedIndex="3" Margin="12,0,0,0" Width="90">
                                            <ComboBoxItem Content="开盘"/><ComboBoxItem Content="最高"/><ComboBoxItem Content="最低"/><ComboBoxItem Content="收盘"/>
                                        </ComboBox>
                                        <ComboBox x:Name="CmbMA3Style" Grid.Column="3" FontSize="11" Height="26" SelectedIndex="0" Margin="12,0,0,0" Width="120">
                                            <ComboBoxItem><Canvas Width="60" Height="16"><Line StartPoint="0,8" EndPoint="60,8" Stroke="{DynamicResource Text1Brush}" StrokeThickness="2"/></Canvas></ComboBoxItem>
                                            <ComboBoxItem><Canvas Width="60" Height="16"><Line StartPoint="0,8" EndPoint="60,8" Stroke="{DynamicResource Text1Brush}" StrokeThickness="2" StrokeDashArray="2,2"/></Canvas></ComboBoxItem>
                                            <ComboBoxItem><Canvas Width="60" Height="16"><Line StartPoint="0,8" EndPoint="60,8" Stroke="{DynamicResource Text1Brush}" StrokeThickness="2" StrokeDashArray="4,3"/></Canvas></ComboBoxItem>
                                            <ComboBoxItem><Canvas Width="60" Height="16"><Line StartPoint="0,8" EndPoint="60,8" Stroke="{DynamicResource Text1Brush}" StrokeThickness="2" StrokeDashArray="1,1"/></Canvas></ComboBoxItem>
                                        </ComboBox>
                                        <Button x:Name="BtnMA3Color" Grid.Column="4" Width="56" Height="26" Padding="0" Background="#FF00FF" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Cursor="Hand" Click="OnColorButtonClick" Margin="15,0,0,0"/>
                                    </Grid>
                                    
                                    <!-- MA4 -->
                                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto">
                                        <CheckBox x:Name="ChkMA4" Grid.Column="0" Content="MA4" IsChecked="False" FontSize="11" Foreground="{DynamicResource Text1Brush}" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtMA4Period" Grid.Column="1" Text="0" FontSize="11" Height="26" Padding="8,0" VerticalContentAlignment="Center" Margin="12,0,0,0" Width="70"/>
                                        <ComboBox x:Name="CmbMA4Field" Grid.Column="2" FontSize="11" Height="26" SelectedIndex="3" Margin="12,0,0,0" Width="90">
                                            <ComboBoxItem Content="开盘"/><ComboBoxItem Content="最高"/><ComboBoxItem Content="最低"/><ComboBoxItem Content="收盘"/>
                                        </ComboBox>
                                        <ComboBox x:Name="CmbMA4Style" Grid.Column="3" FontSize="11" Height="26" SelectedIndex="0" Margin="12,0,0,0" Width="120">
                                            <ComboBoxItem><Canvas Width="60" Height="16"><Line StartPoint="0,8" EndPoint="60,8" Stroke="{DynamicResource Text1Brush}" StrokeThickness="2"/></Canvas></ComboBoxItem>
                                            <ComboBoxItem><Canvas Width="60" Height="16"><Line StartPoint="0,8" EndPoint="60,8" Stroke="{DynamicResource Text1Brush}" StrokeThickness="2" StrokeDashArray="2,2"/></Canvas></ComboBoxItem>
                                            <ComboBoxItem><Canvas Width="60" Height="16"><Line StartPoint="0,8" EndPoint="60,8" Stroke="{DynamicResource Text1Brush}" StrokeThickness="2" StrokeDashArray="4,3"/></Canvas></ComboBoxItem>
                                            <ComboBoxItem><Canvas Width="60" Height="16"><Line StartPoint="0,8" EndPoint="60,8" Stroke="{DynamicResource Text1Brush}" StrokeThickness="2" StrokeDashArray="1,1"/></Canvas></ComboBoxItem>
                                        </ComboBox>
                                        <Button x:Name="BtnMA4Color" Grid.Column="4" Width="56" Height="26" Padding="0" Background="#00FFFF" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Cursor="Hand" Click="OnColorButtonClick" Margin="15,0,0,0"/>
                                    </Grid>
                                    
                                    <!-- MA5 -->
                                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto">
                                        <CheckBox x:Name="ChkMA5" Grid.Column="0" Content="MA5" IsChecked="False" FontSize="11" Foreground="{DynamicResource Text1Brush}" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtMA5Period" Grid.Column="1" Text="0" FontSize="11" Height="26" Padding="8,0" VerticalContentAlignment="Center" Margin="12,0,0,0" Width="70"/>
                                        <ComboBox x:Name="CmbMA5Field" Grid.Column="2" FontSize="11" Height="26" SelectedIndex="3" Margin="12,0,0,0" Width="90">
                                            <ComboBoxItem Content="开盘"/><ComboBoxItem Content="最高"/><ComboBoxItem Content="最低"/><ComboBoxItem Content="收盘"/>
                                        </ComboBox>
                                        <ComboBox x:Name="CmbMA5Style" Grid.Column="3" FontSize="11" Height="26" SelectedIndex="0" Margin="12,0,0,0" Width="120">
                                            <ComboBoxItem><Canvas Width="60" Height="16"><Line StartPoint="0,8" EndPoint="60,8" Stroke="{DynamicResource Text1Brush}" StrokeThickness="2"/></Canvas></ComboBoxItem>
                                            <ComboBoxItem><Canvas Width="60" Height="16"><Line StartPoint="0,8" EndPoint="60,8" Stroke="{DynamicResource Text1Brush}" StrokeThickness="2" StrokeDashArray="2,2"/></Canvas></ComboBoxItem>
                                            <ComboBoxItem><Canvas Width="60" Height="16"><Line StartPoint="0,8" EndPoint="60,8" Stroke="{DynamicResource Text1Brush}" StrokeThickness="2" StrokeDashArray="4,3"/></Canvas></ComboBoxItem>
                                            <ComboBoxItem><Canvas Width="60" Height="16"><Line StartPoint="0,8" EndPoint="60,8" Stroke="{DynamicResource Text1Brush}" StrokeThickness="2" StrokeDashArray="1,1"/></Canvas></ComboBoxItem>
                                        </ComboBox>
                                        <Button x:Name="BtnMA5Color" Grid.Column="4" Width="56" Height="26" Padding="0" Background="#FFA500" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Cursor="Hand" Click="OnColorButtonClick" Margin="15,0,0,0"/>
                                    </Grid>
                                    
                                    <!-- MA6 -->
                                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto">
                                        <CheckBox x:Name="ChkMA6" Grid.Column="0" Content="MA6" IsChecked="False" FontSize="11" Foreground="{DynamicResource Text1Brush}" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtMA6Period" Grid.Column="1" Text="0" FontSize="11" Height="26" Padding="8,0" VerticalContentAlignment="Center" Margin="12,0,0,0" Width="70"/>
                                        <ComboBox x:Name="CmbMA6Field" Grid.Column="2" FontSize="11" Height="26" SelectedIndex="3" Margin="12,0,0,0" Width="90">
                                            <ComboBoxItem Content="开盘"/><ComboBoxItem Content="最高"/><ComboBoxItem Content="最低"/><ComboBoxItem Content="收盘"/>
                                        </ComboBox>
                                        <ComboBox x:Name="CmbMA6Style" Grid.Column="3" FontSize="11" Height="26" SelectedIndex="0" Margin="12,0,0,0" Width="120">
                                            <ComboBoxItem><Canvas Width="60" Height="16"><Line StartPoint="0,8" EndPoint="60,8" Stroke="{DynamicResource Text1Brush}" StrokeThickness="2"/></Canvas></ComboBoxItem>
                                            <ComboBoxItem><Canvas Width="60" Height="16"><Line StartPoint="0,8" EndPoint="60,8" Stroke="{DynamicResource Text1Brush}" StrokeThickness="2" StrokeDashArray="2,2"/></Canvas></ComboBoxItem>
                                            <ComboBoxItem><Canvas Width="60" Height="16"><Line StartPoint="0,8" EndPoint="60,8" Stroke="{DynamicResource Text1Brush}" StrokeThickness="2" StrokeDashArray="4,3"/></Canvas></ComboBoxItem>
                                            <ComboBoxItem><Canvas Width="60" Height="16"><Line StartPoint="0,8" EndPoint="60,8" Stroke="{DynamicResource Text1Brush}" StrokeThickness="2" StrokeDashArray="1,1"/></Canvas></ComboBoxItem>
                                        </ComboBox>
                                        <Button x:Name="BtnMA6Color" Grid.Column="4" Width="56" Height="26" Padding="0" Background="#00FF00" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Cursor="Hand" Click="OnColorButtonClick" Margin="15,0,0,0"/>
                                    </Grid>
                                    
                                    <!-- MA7 -->
                                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto">
                                        <CheckBox x:Name="ChkMA7" Grid.Column="0" Content="MA7" IsChecked="False" FontSize="11" Foreground="{DynamicResource Text1Brush}" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtMA7Period" Grid.Column="1" Text="0" FontSize="11" Height="26" Padding="8,0" VerticalContentAlignment="Center" Margin="12,0,0,0" Width="70"/>
                                        <ComboBox x:Name="CmbMA7Field" Grid.Column="2" FontSize="11" Height="26" SelectedIndex="3" Margin="12,0,0,0" Width="90">
                                            <ComboBoxItem Content="开盘"/><ComboBoxItem Content="最高"/><ComboBoxItem Content="最低"/><ComboBoxItem Content="收盘"/>
                                        </ComboBox>
                                        <ComboBox x:Name="CmbMA7Style" Grid.Column="3" FontSize="11" Height="26" SelectedIndex="0" Margin="12,0,0,0" Width="120">
                                            <ComboBoxItem><Canvas Width="60" Height="16"><Line StartPoint="0,8" EndPoint="60,8" Stroke="{DynamicResource Text1Brush}" StrokeThickness="2"/></Canvas></ComboBoxItem>
                                            <ComboBoxItem><Canvas Width="60" Height="16"><Line StartPoint="0,8" EndPoint="60,8" Stroke="{DynamicResource Text1Brush}" StrokeThickness="2" StrokeDashArray="2,2"/></Canvas></ComboBoxItem>
                                            <ComboBoxItem><Canvas Width="60" Height="16"><Line StartPoint="0,8" EndPoint="60,8" Stroke="{DynamicResource Text1Brush}" StrokeThickness="2" StrokeDashArray="4,3"/></Canvas></ComboBoxItem>
                                            <ComboBoxItem><Canvas Width="60" Height="16"><Line StartPoint="0,8" EndPoint="60,8" Stroke="{DynamicResource Text1Brush}" StrokeThickness="2" StrokeDashArray="1,1"/></Canvas></ComboBoxItem>
                                        </ComboBox>
                                        <Button x:Name="BtnMA7Color" Grid.Column="4" Width="56" Height="26" Padding="0" Background="#FF1493" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Cursor="Hand" Click="OnColorButtonClick" Margin="15,0,0,0"/>
                                    </Grid>
                                    
                                    <!-- MA8 -->
                                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto">
                                        <CheckBox x:Name="ChkMA8" Grid.Column="0" Content="MA8" IsChecked="False" FontSize="11" Foreground="{DynamicResource Text1Brush}" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtMA8Period" Grid.Column="1" Text="0" FontSize="11" Height="26" Padding="8,0" VerticalContentAlignment="Center" Margin="12,0,0,0" Width="70"/>
                                        <ComboBox x:Name="CmbMA8Field" Grid.Column="2" FontSize="11" Height="26" SelectedIndex="3" Margin="12,0,0,0" Width="90">
                                            <ComboBoxItem Content="开盘"/><ComboBoxItem Content="最高"/><ComboBoxItem Content="最低"/><ComboBoxItem Content="收盘"/>
                                        </ComboBox>
                                        <ComboBox x:Name="CmbMA8Style" Grid.Column="3" FontSize="11" Height="26" SelectedIndex="0" Margin="12,0,0,0" Width="120">
                                            <ComboBoxItem><Canvas Width="60" Height="16"><Line StartPoint="0,8" EndPoint="60,8" Stroke="{DynamicResource Text1Brush}" StrokeThickness="2"/></Canvas></ComboBoxItem>
                                            <ComboBoxItem><Canvas Width="60" Height="16"><Line StartPoint="0,8" EndPoint="60,8" Stroke="{DynamicResource Text1Brush}" StrokeThickness="2" StrokeDashArray="2,2"/></Canvas></ComboBoxItem>
                                            <ComboBoxItem><Canvas Width="60" Height="16"><Line StartPoint="0,8" EndPoint="60,8" Stroke="{DynamicResource Text1Brush}" StrokeThickness="2" StrokeDashArray="4,3"/></Canvas></ComboBoxItem>
                                            <ComboBoxItem><Canvas Width="60" Height="16"><Line StartPoint="0,8" EndPoint="60,8" Stroke="{DynamicResource Text1Brush}" StrokeThickness="2" StrokeDashArray="1,1"/></Canvas></ComboBoxItem>
                                        </ComboBox>
                                        <Button x:Name="BtnMA8Color" Grid.Column="4" Width="56" Height="26" Padding="0" Background="#1E90FF" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Cursor="Hand" Click="OnColorButtonClick" Margin="15,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                            
                            <!-- EMA配置面板 -->
                            <StackPanel x:Name="EMAConfigPanel" Spacing="10" IsVisible="False">
                                <TextBlock Text="EMA - 指数移动平均线"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text1Brush}"/>
                                
                                <StackPanel Spacing="15">
                                    <!-- EMA1 -->
                                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto">
                                        <CheckBox x:Name="ChkEMA1" Grid.Column="0" Content="EMA1" IsChecked="True" FontSize="11" Foreground="{DynamicResource Text1Brush}" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtEMA1Period" Grid.Column="1" Text="7" FontSize="11" Height="26" Padding="8,0" VerticalContentAlignment="Center" Margin="12,0,0,0" Width="70"/>
                                        <ComboBox x:Name="CmbEMA1Field" Grid.Column="2" FontSize="11" Height="26" SelectedIndex="3" Margin="12,0,0,0" Width="90">
                                            <ComboBoxItem Content="开盘"/><ComboBoxItem Content="最高"/><ComboBoxItem Content="最低"/><ComboBoxItem Content="收盘"/>
                                        </ComboBox>
                                        <ComboBox x:Name="CmbEMA1Style" Grid.Column="3" FontSize="11" Height="26" SelectedIndex="0" Margin="12,0,0,0" Width="120">
                                            <ComboBoxItem><Canvas Width="60" Height="16"><Line StartPoint="0,8" EndPoint="60,8" Stroke="{DynamicResource Text1Brush}" StrokeThickness="2"/></Canvas></ComboBoxItem>
