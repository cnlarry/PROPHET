                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                            
                            <!-- BOLL配置面板 -->
                            <StackPanel x:Name="BOLLConfigPanel" Spacing="16" IsVisible="False">
                                <TextBlock Text="BOLL - 布林带"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text1Brush}"/>
                                
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Grid.Column="0"
                                                   Text="周期:"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource Text2Brush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0"
                                                   Width="60"/>
                                        <TextBox Grid.Column="1"
                                                 x:Name="TxtBOLLPeriod"
                                                 Text="20"
                                                 FontSize="13"
                                                 Height="32"
                                                 Padding="8,6"
                                                 MaxWidth="120"
                                                 HorizontalAlignment="Left"/>
                                    </Grid>
                                    
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Grid.Column="0"
                                                   Text="标准差:"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource Text2Brush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0"
                                                   Width="60"/>
                                        <TextBox Grid.Column="1"
                                                 x:Name="TxtBOLLStdDev"
                                                 Text="2"
                                                 FontSize="13"
                                                 Height="32"
                                                 Padding="8,6"
                                                 MaxWidth="120"
                                                 HorizontalAlignment="Left"/>
                                    </Grid>
                                    
                                    <TextBlock Text="颜色配置"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text1Brush}"
                                               Margin="0,8,0,4"/>
                                    
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Grid.Column="0"
                                                   Text="上轨:"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource Text2Brush}"
                                                   VerticalAlignment="Center"
                                                   Width="60"/>
                                        <Border Grid.Column="1"
                                                Width="60"
                                                Height="20"
                                                Background="#EF5350"
                                                CornerRadius="4"
                                                HorizontalAlignment="Left"/>
                                    </Grid>
                                    
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Grid.Column="0"
                                                   Text="中轨:"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource Text2Brush}"
                                                   VerticalAlignment="Center"
                                                   Width="60"/>
                                        <Border Grid.Column="1"
                                                Width="60"
                                                Height="20"
                                                Background="#FFD700"
                                                CornerRadius="4"
                                                HorizontalAlignment="Left"/>
                                    </Grid>
                                    
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Grid.Column="0"
                                                   Text="下轨:"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource Text2Brush}"
                                                   VerticalAlignment="Center"
                                                   Width="60"/>
                                        <Border Grid.Column="1"
                                                Width="60"
                                                Height="20"
                                                Background="#26A69A"
                                                CornerRadius="4"
                                                HorizontalAlignment="Left"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                            
                            <!-- VWAP配置面板 -->
