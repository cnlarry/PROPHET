<?xml version="1.0"?>
<SyntaxDefinition name="StrategyDSL" extensions=".dsl" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  
  <!-- Prophet DSL 专属配色方案 - 深色主题优化版 -->
  <Color name="Comment" foreground="#6A9955" fontStyle="italic" /><!-- 注释：柔和绿色，斜体 -->
  <Color name="String" foreground="#CE9178" /><!-- 字符串：橙褐色 -->
  <Color name="Number" foreground="#B5CEA8" /><!-- 数字：淡绿色 -->
  <Color name="Keyword" foreground="#C586C0" fontWeight="bold" /><!-- 控制流关键字：紫红色，加粗 -->
  <Color name="SignalFunction" foreground="#FF79C6" fontWeight="bold" /><!-- 信号函数 ALL/ANY：亮粉色，加粗 -->
  <Color name="DataFunction" foreground="#FFD700" /><!-- 数据函数 HIGHEST/LOWEST：金黄色 -->
  <Color name="TimeSeriesFunction" foreground="#FFA500" fontWeight="bold" /><!-- 时间序列函数 CURRENT/FEARGREED：橙色，加粗 -->
  <Color name="Indicator" foreground="#4EC9B0" fontWeight="bold" /><!-- 指标 $.MACD：青绿色，加粗 -->
  <Color name="LocalVariable" foreground="#67D5E8" /><!-- 局部变量 @score：天蓝色（略深）-->
  <Color name="CustomFunction" foreground="#DCDCAA" fontWeight="bold" /><!-- 自定义函数名：浅黄色，加粗 -->
  <Color name="Field" foreground="#9CDCFE" /><!-- 字段 .trend/.value：浅蓝色 -->
  <Color name="Parameter" foreground="#F1FA8C" /><!-- 参数 FAST_PERIOD：浅黄色 -->
  <Color name="ComparisonOperator" foreground="#4EC9B0" fontWeight="bold" /><!-- 比较运算符 ==, !=：青绿色，加粗（推荐） -->
  <Color name="EqualityOperator" foreground="#D4D4D4" /><!-- 单等号 = ：浅灰色（条件块内可能引起歧义） -->
  <Color name="Operator" foreground="#D4D4D4" /><!-- 其他运算符 +/-/*：浅灰色 -->
  <Color name="Punctuation" foreground="#D4D4D4" /><!-- 标点符号 (){}[]：浅灰色 -->
  <Color name="Signal" foreground="#FF5555" fontWeight="bold" /><!-- 信号类型 BUY/SELL：鲜红色，加粗 -->
  <Color name="Boolean" foreground="#BD93F9" /><!-- 布尔值 true/false：淡紫色 -->
  <Color name="Timeframe" foreground="#50FA7B" /><!-- 时间框架 5m/1h：明亮绿色 -->
  <Color name="Enum" foreground="#F8B500" fontWeight="bold" /><!-- 枚举值 BULLISH/BEARISH：琥珀色，加粗 -->
  
  <!-- 主规则集 -->
  <RuleSet ignoreCase="false">
    
    <!-- 单行注释 // -->
    <Span color="Comment" begin="//" />
    
    <!-- 多行注释 /* ... */ -->
    <Span color="Comment" multiline="true" begin="/\*" end="\*/" />
    
    <!-- 字符串 "..." -->
    <Span color="String">
      <Begin>"</Begin>
      <End>"</End>
      <RuleSet>
        <!-- 转义字符 -->
        <Span begin="\\" end="." />
      </RuleSet>
    </Span>
    
    <!-- 字符串 '...' -->
    <Span color="String">
      <Begin>'</Begin>
      <End>'</End>
      <RuleSet>
        <Span begin="\\" end="." />
      </RuleSet>
    </Span>
    
    <!-- 时间框架 1m/5m/15m/30m/1h/4h/1d（必须在数字规则之前，否则会被拆分） -->
    <Rule color="Timeframe">
      \b(1m|3m|5m|15m|30m|1h|2h|4h|6h|8h|12h|1d)\b
    </Rule>
    
    <!-- 数字（包括小数和科学计数法） -->
    <Rule color="Number">
      \b0[xX][0-9a-fA-F]+  # 十六进制
      |\b\d+(\.\d+)?([eE][+-]?\d+)?  # 十进制、浮点数、科学计数法
    </Rule>
    
    <!-- 布尔值 -->
    <Keywords color="Boolean">
      <Word>true</Word>
      <Word>false</Word>
    </Keywords>
    
    <!-- 控制流关键字 -->
    <Keywords color="Keyword">
      <Word>if</Word>
      <Word>else</Word>
      <Word>for</Word>
      <Word>while</Word>
      <Word>return</Word>
      <Word>break</Word>
      <Word>continue</Word>
      <Word>function</Word>
      <Word>var</Word>
      <Word>let</Word>
      <Word>const</Word>
      <Word>Double</Word>
      <Word>Integer</Word>
      <Word>Boolean</Word>
      <Word>String</Word>
    </Keywords>
    
    <!-- 信号函数 ALL/ANY/WEIGHTED/MIN/MAX/COUNT/VOTE/NONE -->
    <Keywords color="SignalFunction">
      <Word>ALL</Word>
      <Word>ANY</Word>
      <Word>WEIGHTED</Word>
      <Word>WEIGHT</Word>
      <Word>MIN</Word>
      <Word>MAX</Word>
      <Word>COUNT</Word>
      <Word>VOTE</Word>
      <Word>NONE</Word>
    </Keywords>
    
    <!-- 数据函数（基础数据、统计分析、序列条件、高级分析、SMC函数） -->
    <Keywords color="DataFunction">
      <!-- 基础数据访问 -->
      <Word>KLINE</Word>
      <Word>PRICE</Word>
      
      <!-- 统计分析函数 -->
      <Word>HIGHEST</Word>
      <Word>LOWEST</Word>
      <Word>AVERAGE</Word>
      <Word>SUM</Word>
      <Word>MEDIAN</Word>
      <Word>STD</Word>
      <Word>VARIANCE</Word>
      <Word>CHANGE</Word>
      <Word>RANK</Word>
      <Word>SLOPE</Word>
      <Word>ZSCORE</Word>
      <Word>PERCENTILE</Word>
      
      <!-- 序列条件函数 -->
      <Word>CONSECUTIVE</Word>
      <Word>CONSEC</Word>
      
      <!-- 高级分析函数 -->
      <Word>CROSS</Word>
      <Word>VOLA</Word>
      <Word>ATR</Word>
      <Word>HT</Word>
      <Word>POWER</Word>
      <Word>PATTERN</Word>
      
      <!-- Smart Money Concepts (SMC) 函数 -->
      <Word>FVG</Word>
      <Word>PREMIUM</Word>
      <Word>ORDERBLOCK</Word>
      <Word>SWING</Word>
      <Word>BOS</Word>
      <Word>CHOCH</Word>
      <Word>LIQUIDITY</Word>
      <Word>BREAKER</Word>
    </Keywords>
    
    <!-- 时间序列函数（无需时间框架参数） -->
    <Keywords color="TimeSeriesFunction">
      <Word>CURRENT</Word>
      <Word>FEARGREED</Word>
      <Word>FUNDINGRATE</Word>
    </Keywords>
    
    <!-- 信号类型 BUY/SELL/HOLD -->
    <Keywords color="Signal">
      <Word>BUY</Word>
      <Word>SELL</Word>
      <Word>HOLD</Word>
    </Keywords>
    
    <!-- 枚举值（MACD趋势、RSI水平、ATR波动率等） -->
    <Keywords color="Enum">
      <Word>BULLISH</Word>
      <Word>BEARISH</Word>
      <Word>NEUTRAL</Word>
      <Word>GOLDEN_CROSS</Word>
      <Word>DEATH_CROSS</Word>
      <Word>NONE</Word>
      <Word>OVERBOUGHT</Word>
      <Word>OVERSOLD</Word>
      <Word>HIGH</Word>
      <Word>MEDIUM</Word>
      <Word>LOW</Word>
      <Word>STRONG</Word>
      <Word>MODERATE</Word>
      <Word>WEAK</Word>
      <Word>RISING</Word>
      <Word>FALLING</Word>
      <Word>STABLE</Word>
    </Keywords>
    
    <!-- 指标调用 $.MACD / $.RSI / $.EMA 等（62个技术指标） -->
    <Rule color="Indicator">
      \$\.(MACD|RSI|EMA|MA|BOLL|ATR|KDJ|ADX|Alligator|STOCHRSI|CCI|OBV|VWAP|Supertrend|WR|MFI|SAR|ParabolicTP|WMA|ROC|AROON|TRIX|DMI|CMO|TEMA|DEMA|KAMA|McGinleyDynamic|T3|MAMA|STOCHF|ULTOSC|PPO|APO|ElderRay|FisherTransform|SchaffTrendCycle|ADOSC|NATR|MTM|Ichimoku|CMF|EMV|ForceIndex|VolumePriceTrend|Keltner|DonchianChannel|PivotPoints|StdDev|VWMA|SwingHL|VWAPBands|HV|ChandelierExit|ChoppinessIndex|TSI|BollingerBW|MSB|ADL|HHLL|LinearRegSlope|KaufmanER)
    </Rule>
    
    <!-- 局部变量 @score / @my_var 等（自定义函数内使用）-->
    <Rule color="LocalVariable">
      @[a-z][a-z0-9_]*
    </Rule>
    
    <!-- 自定义函数名称（小写字母开头）-->
    <Rule color="CustomFunction">
      \b[a-z][a-zA-Z0-9_]*(?=\s*\()
    </Rule>
    
    <!-- 字段访问 .trend / .value / .crossover_type 等 -->
    <Rule color="Field">
      \.(trend|value|pct|crossover_type|histogram|macd|signal|slope|distance|upper|middle|lower|width|percent|volatility|overbought|oversold|level|open|high|low|close|volume|zero_cross|momentum|percent_b|k|d|j|aroon_up|aroon_down|oscillator|plus_di|minus_di|adx|trend_strength|mama|fama|ppo|annual|tsi|break_level|is_bullish_msb|is_bearish_msb|is_higher_high|is_lower_low|is_higher_low|is_lower_high|trend_structure|tenkan|kijun|senkou_a|senkou_b|chikou|percent_k|direction|islong|isshort|position|pp|r1|r2|r3|s1|s2|s3|swing_high|swing_low|is_swing_high|is_swing_low|vwap|long_stop|short_stop|market_state|bandwidth|squeeze|jaw|teeth|lips|state|bull_power|bear_power|net_power|fisher|trigger|strength|efficiency|angle|time_factor|confidence|msb_type|filled|remaining|price|broken|swept|buyside|sellside|isfull|ispartial|top|bottom|mid|size)
    </Rule>
    
    <!-- 参数名称（大写下划线风格） -->
    <Rule color="Parameter">
      \b[A-Z_][A-Z0-9_]*\b
    </Rule>
    
    <!-- 比较运算符（推荐使用，优先匹配） -->
    <Rule color="ComparisonOperator">
      ==|!=|&gt;=|&lt;=|&gt;|&lt;
    </Rule>
    
    <!-- 单等号（可能引起歧义，次优先级） -->
    <Rule color="EqualityOperator">
      (?&lt;![=!&gt;&lt;])=(?![=])
    </Rule>
    
    <!-- 其他运算符 -->
    <Rule color="Operator">
      [+\-*/%&amp;|]+
    </Rule>
    
    <!-- 标点符号 -->
    <Rule color="Punctuation">
      [(){}[\];,.]
    </Rule>
    
  </RuleSet>
  
</SyntaxDefinition>

