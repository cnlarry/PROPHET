<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Prophet.Client.Controls.SvgIcon">
    
    <Viewbox Width="{Binding $parent.Width}" 
             Height="{Binding $parent.Height}"
             Stretch="Uniform">
        <Path x:Name="IconPath" 
              Fill="{Binding $parent[UserControl].Foreground}"
              Stretch="Uniform"/>
    </Viewbox>
    
</UserControl>

