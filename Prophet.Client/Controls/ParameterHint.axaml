<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:av="https://github.com/avaloniaui"
             xmlns:controls="clr-namespace:Prophet.Client.Controls"
             x:Class="Prophet.Client.Controls.ParameterHint"
             Background="Transparent"
             Focusable="False"
             IsHitTestVisible="False">
    
    <Border Background="#2D2D30"
            BorderBrush="#3E3E42"
            BorderThickness="1"
            Padding="8,6"
            MaxWidth="500"
            BoxShadow="0 2 4 0 #40000000">
        
        <StackPanel Spacing="4">
            <!-- 函数/字段名称 -->
            <TextBlock Name="FunctionNameText"
                       FontFamily="Consolas,Courier New"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#4EC9B0"
                       TextWrapping="Wrap"/>
            
            <!-- 参数列表 -->
            <TextBlock Name="ParametersText"
                       FontFamily="Consolas,Courier New"
                       FontSize="11"
                       TextWrapping="Wrap"
                       LineHeight="18"/>
            
            <!-- 参数描述 -->
            <TextBlock Name="DescriptionText"
                       FontSize="11"
                       Foreground="#CCCCCC"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"
                       LineHeight="16"/>
        </StackPanel>
    </Border>
</UserControl>

